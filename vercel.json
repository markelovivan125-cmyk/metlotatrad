{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/nc/:path*", "destination": "/api/nc/nc?p=:path*" },
    { "source": "/api/nc/:path*", "destination": "/api/nc/nc?p=:path*" },
    { "source": "/proxy", "destination": "/api/proxy" }
  ],
  "functions": {
    "api/nc/nc.mjs": { "maxDuration": 60 },
    "api/proxy.mjs": { "maxDuration": 60 }
  }
}
