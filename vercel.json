{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/nc/(.*)", "destination": "/api/nc/$1" },
    { "source": "/proxy", "destination": "/api/proxy" }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  }
}
